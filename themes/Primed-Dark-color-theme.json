	"tokenColors": [
		{
			"scope": [
				"keyword.other.important",
				"markup.bold",
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic",
				"meta.tag entity.other.attribute-name",
				"entity.other.attribute-name.html"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"entity.name.namespace",
				"meta.class",
				"meta.separator",
				"keyword.operator",
				"keyword.operator.delete.array.bracket",
				"keyword.operator.memory.delete.array.bracket",
				"storage.modifier.pointer",
				"storage.modifier.reference",
				"storage.type.function.arrow",
				"punctuation.section.scope",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html",
				"support.function.core",
				"variable.other",
				"variable.parameter",
				"variable.other.constant",
				"variable.other.block",
				"variable.other.readwrite.instance",

				// CSS
				"meta.property-value",
				"meta.property-value constant.other",
				"support.constant.property-value"
			],
			"settings": {
				"foreground": "#ccd3da"
			}
		},
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"markup.inline.raw.string.markdown" //markdown inline code
			],
			"settings": {
				"foreground": "#858d94"
			}
		},
		{
			"scope": [
				"token.error-token",
				"string.other.link",
				"invalid"
			],
			"settings": {
				"foreground": "#f07070"
			}
		},
		{
			"scope": [
				"token.info-token",
				"keyword.control.directive",
				"keyword.preprocessor",
				"entity.name.function.preprocessor",
				"entity.name.variable.preprocessor",
				"markup.deleted"
			],
			"settings": {
				"foreground": "#e8666d"
			}
		},
		{
			"scope": [
				"support.class",
				"support.type",
				"entity.name.type",
				"entity.name.type.class",
				"entity.other.inherited-class",
				"entity.other.attribute",
				"entity.name.scope-resolution",
				"entity.name.class",
				"storage.type.numeric.go",
				"storage.type.byte.go",
				"storage.type.boolean.go",
				"storage.type.string.go",
				"storage.type.uintptr.go",
				"storage.type.error.go",
				"storage.type.rune.go",
				"storage.type.cs",
				"storage.type.generic.cs",
				"storage.type.modifier.cs",
				"storage.type.variable.cs",
				"storage.type.annotation.java",
				"storage.type.generic.java",
				"storage.type.java",
				"storage.type.object.array.java",
				"storage.type.primitive.array.java",
				"storage.type.primitive.java",
				"storage.type.token.java",
				"storage.type.groovy",
				"storage.type.annotation.groovy",
				"storage.type.parameters.groovy",
				"storage.type.generic.groovy",
				"storage.type.object.array.groovy",
				"storage.type.primitive.array.groovy",
				"storage.type.primitive.groovy"
			],
			"settings": {
				"foreground": "#43b9d9"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.other.symbol",
				"constant.language.symbol",
				"keyword.other.unit",
				"keyword.other.operator.overload.cpp",
				"keyword.other.operator.custom-literal.cpp",
				"storage.type.number",
				"storage.type.imaginary.number"
			],
			"settings": {
				"foreground": "#48c2a9"
			}
		},
		{
			"scope": [
				"variable.other.enummember",
				"punctuation.definition.variable"
			],
			"settings": {
				"foreground": "#8fbab5"
			}
		},
		{
			"scope": [
				"constant",
				"constant.language",
				"constant.character.escape",
				"storage.type.format"
			],
			"settings": {
				"foreground": "#a991f7"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.other.this",
				"keyword.operator.new",
				"keyword.operator.delete",
				"keyword.operator.memory",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.alignof",
				"keyword.operator.alignas",
				"keyword.operator.typeid",
				"keyword.operator.noexcept",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"keyword.operator.functionlike",
				"keyword.operator.quantifier.regexp",
				"keyword.operator.or.regexp",
				"keyword.operator.disjunction.regexp",
				"keyword.operator.negation.regexp",
				"storage",
				"support.type.primitive",
				"support.type.builtin",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super",
				"variable.language.special.self",
				"variable.language.special.cls",
				"variable.parameter.function.language.special.self",
				"variable.parameter.function.language.special.cls",

				// JSON, CSS
				"support.type.property-name",
				"support.type.vendored.property-name",

				// HTML
				"entity.name.tag",

				// Markdown
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#6aa4e8"
			}
		},
		{
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#c586d6"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"entity.other.attribute-name",
				"entity.other.attribute-name.id",
				"meta.function-call.generic",
				"keyword.other.special-method",
				"punctuation.definition.entity",
				"punctuation.decorator",
				//"meta.link",
				"meta.require",
				"string.regexp",
				"support.function",
				"support.function.any-method",
				"meta.tag entity.other.attribute-name",
				"entity.other.attribute-name.html",

				// CSS
				"meta.selector",
				"meta.selector entity",
				"meta.selector entity punctuation",
				"entity.name.tag.css",
				"constant.character.entity",
				"punctuation.definition.entity",

				// Markdown
				"markup.italic",
				"markup.bold",
				"markup.strikethrough",
				"punctuation.definition.italic",
				"punctuation.definition.bold",
				"punctuation.definition.strikethrough"
			],
			"settings": {
				"foreground": "#d7a35f"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"markup.quote",
				"markup.inserted"
			],
			"settings": {
				"foreground": "#7cc287"
			}
		},
		{
			"scope": [
				"markup.changed",
				"token.warn-token"
			],
			"settings": {
				"foreground": "#d6a72c"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#c678dd"
			}
		},

		// Log files and the Output panel
		{
			"scope": "log.info",
			"settings": {
				"foreground": "#7cc287"
			}
		},
		{
			"scope": "log.warning",
			"settings": {
				"foreground": "#d6a72c"
			}
		},
		{
			"scope": "log.error",
			"settings": {
				"foreground": "#f07070"
			}
		},
		{
			"scope": [
				"log.exception",
				"log.exceptiontype"
			],
			"settings": {
				"foreground": "#e8666d"
			}
		},
		{
			"scope": "log.debug",
			"settings": {
				"foreground": "#858d94"
			}
		}
	],
	"semanticTokenColors": {
		"namespace": "#ccd3da", //identifiers that declare or reference a namespace, module, or package
		"class": "#43b9d9", //identifiers that declare or reference a class type
		"enum": "#43b9d9", //identifiers that declare or reference an enumeration type
		"interface": "#43b9d9", //identifiers that declare or reference an interface type
		"struct": "#43b9d9", //identifiers that declare or reference a struct type
		"typeParameter": "#43b9d9", //identifiers that declare or reference a type parameter
		"type": "#43b9d9", //identifiers that declare or reference a type that is not covered above
		"module": "#43b9d9",
		"parameter": "#ccd3da", //identifiers that declare or reference a function or method parameters
		"variable": "#ccd3da", //identifiers that declare or reference a local or global variable
		"property": "#ccd3da", //identifiers that declare or reference a member property, member field, or member variable
		"enumMember": "#8fbab5", //identifiers that declare or reference an enumeration property, constant, or member
		//"decorator": "#FF0000", //identifiers that declare or reference decorators and annotations
		//"event": "#FF0000", //identifiers that declare an event property
		"function": "#d7a35f", //identifiers that declare a function
		"method": "#d7a35f", //identifiers that declare a member function or method
		"macro": "#e8666d", //identifiers that declare a macro
		//"label": "#FF0000", //identifiers that declare a label
		"comment": "#858d94", //tokens that represent a comment
		"string": "#7cc287", //tokens that represent a string literal
		"keyword": "#6aa4e8", //tokens that represent a language keyword
		"controlKeyword": "#c586d6",
		"preprocessorKeyword": "#e8666d",
		"excludedCode": "#858d94", //C# code in inactive #if blocks
		"selfParameter": "#6aa4e8",
		"clsParameter": "#6aa4e8",
		"number": "#48c2a9", //tokens that represent a number literal
		"builtinConstant": "#a991f7",
		//"regexp": "#FF0000", //tokens that represent a regular expression literal
		"operator": "#ccd3da", //tokens that represent an operator
		"operatorOverload": "#48c2a9",
		"memberOperatorOverload": "#48c2a9",
		"operatorOverloaded": "#48c2a9", //C# overloaded operators
		"newOperator": "#6aa4e8", //new/delete operator tokens
		"numberLiteral": "#48c2a9", //C++ user-defined literals
		"customLiteral": "#48c2a9",
		"stringLiteral": "#7cc287"
	}
}
