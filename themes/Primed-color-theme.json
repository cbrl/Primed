	"tokenColors": [
		{
			"scope": [
				"keyword.other.important",
				"markup.bold",
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic",
				"meta.tag entity.other.attribute-name",
				"entity.other.attribute-name.html"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.underline",
			"settings": {
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"entity.name.namespace",
				"meta.class",
				"meta.separator",
				"keyword.operator",
				"keyword.operator.delete.array.bracket",
				"keyword.operator.memory.delete.array.bracket",
				"storage.modifier.pointer",
				"storage.modifier.reference",
				"storage.type.function.arrow",
				"punctuation.section.scope",
				"punctuation.definition.tag.begin.html",
				"punctuation.definition.tag.end.html",
				"support.function.core",
				"variable.other",
				"variable.parameter",
				"variable.other.constant",
				"variable.other.block",
				"variable.other.readwrite.instance",

				// CSS
				"meta.property-value",
				"meta.property-value constant.other",
				"support.constant.property-value"
			],
			"settings": {
				"foreground": "#33434B"
			}
		},
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"markup.inline.raw.string.markdown" //markdown inline code
			],
			"settings": {
				"foreground": "#969896"
			}
		},
		{
			"scope": [
				"token.error-token",
				"string.other.link",
				"invalid"
			],
			"settings": {
				"foreground": "#E03939"
			}
		},
		{
			"scope": [
				"token.info-token",
				"keyword.control.directive",
				"keyword.preprocessor",
				"entity.name.function.preprocessor",
				"entity.name.variable.preprocessor",
				"markup.deleted"
			],
			"settings": {
				"foreground": "#CA272F"
			}
		},
		{
			"scope": [
				"support.class",
				"support.type",
				"entity.name.type",
				"entity.name.type.class",
				"entity.other.inherited-class",
				"entity.other.attribute",
				"entity.name.scope-resolution",
				"entity.name.class",
				"storage.type.numeric.go",
				"storage.type.byte.go",
				"storage.type.boolean.go",
				"storage.type.string.go",
				"storage.type.uintptr.go",
				"storage.type.error.go",
				"storage.type.rune.go",
				"storage.type.cs",
				"storage.type.generic.cs",
				"storage.type.modifier.cs",
				"storage.type.variable.cs",
				"storage.type.annotation.java",
				"storage.type.generic.java",
				"storage.type.java",
				"storage.type.object.array.java",
				"storage.type.primitive.array.java",
				"storage.type.primitive.java",
				"storage.type.token.java",
				"storage.type.groovy",
				"storage.type.annotation.groovy",
				"storage.type.parameters.groovy",
				"storage.type.generic.groovy",
				"storage.type.object.array.groovy",
				"storage.type.primitive.array.groovy",
				"storage.type.primitive.groovy"
			],
			"settings": {
				"foreground": "#2296B6"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.other.symbol",
				"constant.language.symbol",
				"keyword.other.unit",
				"keyword.other.operator.overload.cpp",
				"keyword.other.operator.custom-literal.cpp",
				"storage.type.number",
				"storage.type.imaginary.number"
			],
			"settings": {
				"foreground": "#078B8B"
			}
		},
		{
			"scope": [
				"variable.other.enummember",
				"punctuation.definition.variable"
			],
			"settings": {
				"foreground": "#336363"
			}
		},
		{
			"scope": [
				"constant",
				"constant.language",
				"constant.character.escape",
				"storage.type.format"
			],
			"settings": {
				"foreground": "#6D54EB"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.other.this",
				"keyword.operator.new",
				"keyword.operator.delete",
				"keyword.operator.memory",
				"keyword.operator.expression",
				"keyword.operator.cast",
				"keyword.operator.sizeof",
				"keyword.operator.alignof",
				"keyword.operator.alignas",
				"keyword.operator.typeid",
				"keyword.operator.noexcept",
				"keyword.operator.instanceof",
				"keyword.operator.logical.python",
				"keyword.operator.wordlike",
				"keyword.operator.functionlike",
				"keyword.operator.quantifier.regexp",
				"keyword.operator.or.regexp",
				"keyword.operator.disjunction.regexp",
				"keyword.operator.negation.regexp",
				"storage",
				"support.type.primitive",
				"support.type.builtin",
				"variable.language.this",
				"variable.language.self",
				"variable.language.super",
				"variable.language.special.self",
				"variable.language.special.cls",
				"variable.parameter.function.language.special.self",
				"variable.parameter.function.language.special.cls",

				// JSON, CSS
				"support.type.property-name",
				"support.type.vendored.property-name",

				// HTML
				"entity.name.tag",

				// Markdown
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#316BCD"
			}
		},
		{
			"scope": [
				"keyword.control"
			],
			"settings": {
				"foreground": "#9C33B1"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"entity.other.attribute-name",
				"entity.other.attribute-name.id",
				"meta.function-call.generic",
				"keyword.other.special-method",
				"punctuation.definition.entity",
				"punctuation.decorator",
				//"meta.link",
				"meta.require",
				"string.regexp",
				"support.function",
				"support.function.any-method",
				"meta.tag entity.other.attribute-name",
				"entity.other.attribute-name.html",

				// CSS
				"meta.selector",
				"meta.selector entity",
				"meta.selector entity punctuation",
				"entity.name.tag.css",
				"constant.character.entity",
				"punctuation.definition.entity",

				// Markdown
				"markup.italic",
				"markup.bold",
				"markup.strikethrough",
				"punctuation.definition.italic",
				"punctuation.definition.bold",
				"punctuation.definition.strikethrough"
			],
			"settings": {
				"foreground": "#AB6526"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string",
				"markup.quote",
				"markup.inserted"
			],
			"settings": {
				"foreground": "#208C47"
			}
		},
		{
			"scope": [
				"markup.changed",
				"token.warn-token"
			],
			"settings": {
				"foreground": "#A87A00"
			}
		},
		{
			"scope": "token.debug-token",
			"settings": {
				"foreground": "#800080"
			}
		},

		// Log files and the Output panel
		{
			"scope": "log.info",
			"settings": {
				"foreground": "#208C47"
			}
		},
		{
			"scope": "log.warning",
			"settings": {
				"foreground": "#A87A00"
			}
		},
		{
			"scope": "log.error",
			"settings": {
				"foreground": "#E03939"
			}
		},
		{
			"scope": [
				"log.exception",
				"log.exceptiontype"
			],
			"settings": {
				"foreground": "#CA272F"
			}
		},
		{
			"scope": "log.debug",
			"settings": {
				"foreground": "#969896"
			}
		}
	],
	"semanticTokenColors": {
		"namespace": "#33434B", //identifiers that declare or reference a namespace, module, or package
		"class": "#2296B6", //identifiers that declare or reference a class type
		"enum": "#2296B6", //identifiers that declare or reference an enumeration type
		"interface": "#2296B6", //identifiers that declare or reference an interface type
		"struct": "#2296B6", //identifiers that declare or reference a struct type
		"typeParameter": "#2296B6", //identifiers that declare or reference a type parameter
		"type": "#2296B6", //identifiers that declare or reference a type that is not covered above
		"module": "#2296B6",
		"parameter": "#33434B", //identifiers that declare or reference a function or method parameters
		"variable": "#33434B", //identifiers that declare or reference a local or global variable
		"property": "#33434B", //identifiers that declare or reference a member property, member field, or member variable
		"enumMember": "#336363", //identifiers that declare or reference an enumeration property, constant, or member
		//"decorator": "#FF0000", //identifiers that declare or reference decorators and annotations
		//"event": "#FF0000", //identifiers that declare an event property
		"function": "#AB6526", //identifiers that declare a function
		"method": "#AB6526", //identifiers that declare a member function or method
		"macro": "#CA272F", //identifiers that declare a macro
		//"label": "#FF0000", //identifiers that declare a label
		"comment": "#969896", //tokens that represent a comment
		"string": "#208C47", //tokens that represent a string literal
		"keyword": "#316BCD", //tokens that represent a language keyword
		"controlKeyword": "#9C33B1",
		"preprocessorKeyword": "#CA272F",
		"excludedCode": "#969896", //C# code in inactive #if blocks
		"selfParameter": "#316BCD",
		"clsParameter": "#316BCD",
		"number": "#078B8B", //tokens that represent a number literal
		"builtinConstant": "#6D54EB",
		//"regexp": "#FF0000", //tokens that represent a regular expression literal
		"operator": "#33434B", //tokens that represent an operator
		"operatorOverload": "#078B8B",
		"memberOperatorOverload": "#078B8B",
		"operatorOverloaded": "#078B8B", //C# overloaded operators
		"newOperator": "#316BCD", //new/delete operator tokens
		"numberLiteral": "#078B8B", //C++ user-defined literals
		"customLiteral": "#078B8B",
		"stringLiteral": "#208C47"
	}
}
